# ============================================================
# Majordom Financiar v2 — Configuration
# Copy this file as .env and fill in your values.
# Never commit .env to git — it contains secrets.
# ============================================================

# --- Web UI Authentication ---
# Two users are supported. Add more by following the USER1/USER2 pattern.
# Passwords are stored as plaintext here and hashed in memory at startup.
# Minimum recommended password length: 12 characters.

USER1_USERNAME=your_username
USER1_PASSWORD=change_me_please

USER2_USERNAME=partner_username   # optional — remove if not needed
USER2_PASSWORD=change_me_please   # optional

# JWT secret — used to sign login tokens.
# Generate a strong random value: python3 -c "import secrets; print(secrets.token_hex(32))"
# If this changes, all logged-in users will be logged out automatically.
JWT_SECRET=generate_a_random_secret_here

# Port for the web UI (default: 3000).
# Access the app at http://your-server-ip:3000 (or via Tailscale hostname).
WEB_PORT=3000

# --- Actual Budget ---
# URL is internal Docker network name — don't change unless you run Actual Budget separately
ACTUAL_BUDGET_URL=http://actual-budget:5006
ACTUAL_BUDGET_PASSWORD=your_actual_budget_password
# Sync ID: open Actual Budget → Settings → Advanced → Sync ID
ACTUAL_BUDGET_SYNC_ID=your_sync_id_here
# Public URL of Actual Budget, linked from the Home menu in the web UI.
# Set this to your own domain (e.g. https://ab.example.com) or leave empty to
# fall back to the current host on port 5006. Baked in at frontend build time.
ACTUAL_BUDGET_PUBLIC_URL=

# Public URL of the Transport (vehicle-manager) web app, used to hand off a
# vehicle-linked account's detail page there. Leave empty to keep the local
# (always-empty) account detail view instead. Baked in at frontend build time.
VEHICLE_APP_PUBLIC_URL=

# Public URL of Majordom Finance itself (this app's own web UI) and of
# Majordom Invest — passed to Transport and Invest's own frontend builds so
# their shared "Majordom" chat button and Settings cross-app links resolve
# correctly. Leave empty and each falls back to the local-dev default
# (http://localhost:3000 / http://localhost:3020). Baked in at build time,
# only needed if you run the vehicle-manager/investment-manager profiles.
WEB_PUBLIC_URL=
INVESTMENT_MANAGER_PUBLIC_URL=

# --- LLM Provider ---
# For local Ollama running in this same Docker Compose stack (start with
# `docker compose --profile ollama-local up -d`): leave LLM_BASE_URL as-is below —
# "ollama" is the internal Docker network name, resolved automatically.
# For an external Ollama server elsewhere on your network: replace with that
# server's address, e.g. http://192.168.1.50:11434, and start without the
# ollama-local profile (`docker compose up -d`).
# For OpenRouter: set LLM_BASE_URL=https://openrouter.ai/api/v1 and LLM_API_KEY.
# For DeepSeek API: LLM_BASE_URL=https://api.deepseek.com/v1
# Any OpenAI-compatible API works.

LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=                          # leave empty for local Ollama
LLM_CHAT_MODEL=qwen3.5:9b
LLM_VISION_MODEL=qwen3.5:9b
LLM_CATEGORIZE_MODEL=                 # optional, defaults to LLM_CHAT_MODEL

# --- SQLite Web Viewer ---
# Password for the database viewer at :8888.
SQLITE_WEB_PASSWORD=change_me_please

# --- Memory / Categorization ---
MEMORY_DB_PATH=/app/data/memory.db

# --- General ---
DEFAULT_CURRENCY=EUR
TZ=Europe/Amsterdam
LOG_LEVEL=INFO

# --- Vehicle Manager (optional service, --profile vehicle-manager) ---
# Shared secret this app sends on every internal call to vehicle-manager.
# Must match VEHICLE_MANAGER_SERVICE_TOKEN in tools/vehicle-manager/.env exactly.
# Generate a strong random value: python3 -c "import secrets; print(secrets.token_hex(32))"
VEHICLE_MANAGER_SERVICE_TOKEN=change_this_to_a_random_secret

# Vehicle-manager's own login (its standalone frontend, not this app) —
# separate from USER1_USERNAME/PASSWORD above, though you can reuse the same
# values if you only want one password to remember. See
# tools/vehicle-manager/.env.example for the corresponding vars there.
VEHICLE_MANAGER_JWT_SECRET=change_this_to_a_random_secret
VEHICLE_MANAGER_USER1_USERNAME=your_username
VEHICLE_MANAGER_USER1_PASSWORD=change_me_please

# Port for vehicle-manager's own standalone web frontend (default: 3010).
VEHICLE_MANAGER_WEB_PORT=3010

# --- Investment Manager (optional service, --profile investment-manager) ---
# Shared secret this app sends on every internal call to investment-manager.
# Must match INVESTMENT_MANAGER_SERVICE_TOKEN in tools/investment-manager/.env exactly.
# Generate a strong random value: python3 -c "import secrets; print(secrets.token_hex(32))"
INVESTMENT_MANAGER_SERVICE_TOKEN=change_this_to_a_random_secret

# Investment-manager's own login (its standalone frontend, not this app) —
# separate from USER1_USERNAME/PASSWORD above, though you can reuse the same
# values if you only want one password to remember. See
# tools/investment-manager/.env.example for the corresponding vars there.
INVESTMENT_MANAGER_JWT_SECRET=change_this_to_a_random_secret
INVESTMENT_MANAGER_USER1_USERNAME=your_username
INVESTMENT_MANAGER_USER1_PASSWORD=change_me_please

# Port for investment-manager's own standalone web frontend (default: 3020).
INVESTMENT_MANAGER_WEB_PORT=3020

# Twelve Data API key (investment-manager's market-price source, free tier).
# Only read by the investment-manager container itself; leave blank to run
# without live prices. https://twelvedata.com
TWELVE_DATA_API_KEY=
