#!/usr/bin/env bash

YELLOW='\033[1;33m'
NC='\033[0m'

# Commit timestamp window check (weekdays only — local rule, not tracked in git)
# NOTE: git always sets GIT_AUTHOR_DATE for hooks during `git commit`, even
# without a manual override — in the raw "@<epoch> <tz>" form, not the
# "YYYY-MM-DD HH:MM:SS +0200" form the old regex expected. That made the old
# regex always fail silently (empty COMMIT_HOUR), which bash's arithmetic
# comparison then treated as 0 — always "before 18:00", a false positive on
# every single commit regardless of actual time.
if [[ -n "$GIT_AUTHOR_DATE" ]]; then
    PARSE_DATE="$GIT_AUTHOR_DATE"
    [[ "$PARSE_DATE" == @* ]] && PARSE_DATE="${PARSE_DATE%% *}"
    COMMIT_HOUR=$(date -d "$PARSE_DATE" +%H 2>/dev/null)
    COMMIT_DOW=$(date -d "$PARSE_DATE" +%u 2>/dev/null)
fi
if [[ -z "$COMMIT_HOUR" || -z "$COMMIT_DOW" ]]; then
    COMMIT_HOUR=$(date +%H)
    COMMIT_DOW=$(date +%u)
fi
# Force base-10: date pads hours like 08/09, which bash's arithmetic
# comparison below would otherwise reject as invalid octal literals.
COMMIT_HOUR=$((10#$COMMIT_HOUR))

# %u: 1=Monday...5=Friday, 6=Saturday, 7=Sunday
# "Weekend" for this rule is Friday 17:00 through Sunday 23:00 — real time is
# fine anywhere in that window, no warning. Corrected 2026-08-30 (the prior
# version excluded all of Sunday, and didn't special-case Friday's own start
# time, treating the whole of Friday as exempt regardless of hour).
WEEKEND_EXEMPT=0
if [[ "$COMMIT_DOW" -eq 6 ]]; then
    WEEKEND_EXEMPT=1
elif [[ "$COMMIT_DOW" -eq 5 && "$COMMIT_HOUR" -ge 17 ]]; then
    WEEKEND_EXEMPT=1
elif [[ "$COMMIT_DOW" -eq 7 && "$COMMIT_HOUR" -lt 23 ]]; then
    WEEKEND_EXEMPT=1
fi

if [[ "$WEEKEND_EXEMPT" -eq 0 && ( "$COMMIT_HOUR" -lt 18 || "$COMMIT_HOUR" -ge 23 ) ]]; then
    echo -e "${YELLOW}⚠️  Timestamp outside preferred window (18:00–23:00) — commit hour: ${COMMIT_HOUR}:xx${NC}"
    echo "   To set a custom timestamp:"
    echo "   GIT_AUTHOR_DATE=\"YYYY-MM-DD HH:MM:SS +0200\" GIT_COMMITTER_DATE=\"...\" git commit -m \"...\""
fi

ROOT="$(git rev-parse --show-toplevel)"
if ! python3 "$ROOT/majordom-financiar/scripts/check_provider_wiring.py"; then
    exit 1
fi

exec "$ROOT/scripts/check-private-data.sh"
