# ============================================================
# investment-manager — Configuration
# Copy this file as .env and fill in your values.
# Never commit .env to git — it contains secrets.
#
# Only needed when running investment-manager standalone (uvicorn directly,
# not via majordom-financiar's docker-compose). When run through
# docker-compose --profile investment-manager, these same variable names are
# instead read from majordom-financiar/.env and passed in via
# docker-compose.yml's `environment:` block.
# ============================================================

# --- Login (this service's own standalone frontend) ---
INVESTMENT_MANAGER_USER1_USERNAME=your_username
INVESTMENT_MANAGER_USER1_PASSWORD=change_this_to_a_random_secret

# JWT secret — used to sign this service's own login tokens.
# Generate a strong random value: python3 -c "import secrets; print(secrets.token_hex(32))"
INVESTMENT_MANAGER_JWT_SECRET=change_this_to_a_random_secret

# --- Service token (majordom-financiar's internal calls) ---
# Must match INVESTMENT_MANAGER_SERVICE_TOKEN in majordom-financiar/.env
# exactly — this is what lets majordom-financiar's coaching/notifications
# call this service without a per-user login.
INVESTMENT_MANAGER_SERVICE_TOKEN=change_this_to_a_random_secret

# --- Market data (Twelve Data) ---
# Free tier: https://twelvedata.com — 800 calls/day, sufficient for a
# once-or-twice-daily price refresh across a personal holdings list.
TWELVE_DATA_API_KEY=change_this_to_a_random_secret
