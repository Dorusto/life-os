# ============================================================
# vehicle-manager — Configuration
# Copy this file as .env and fill in your values.
# Never commit .env to git — it contains secrets.
#
# Only needed when running vehicle-manager standalone (uvicorn directly,
# not via majordom-financiar's docker-compose). When run through
# docker-compose --profile vehicle-manager, these same variable names are
# instead read from majordom-financiar/.env and passed in via
# docker-compose.yml's `environment:` block — see that file's
# VEHICLE_MANAGER_* entries.
# ============================================================

# --- Login (this service's own standalone frontend) ---
# Separate from majordom-financiar's own USER1_USERNAME/PASSWORD — reuse the
# same values if you only want one password to remember, but the two are
# never interchangeable (separate secrets, separate token issuers).
VEHICLE_MANAGER_USER1_USERNAME=your_username
VEHICLE_MANAGER_USER1_PASSWORD=change_me_please

# JWT secret — used to sign this service's own login tokens.
# Generate a strong random value: python3 -c "import secrets; print(secrets.token_hex(32))"
VEHICLE_MANAGER_JWT_SECRET=change_this_to_a_random_secret

# --- Service token (majordom-financiar's internal calls) ---
# Must match VEHICLE_MANAGER_SERVICE_TOKEN in majordom-financiar/.env exactly —
# this is what lets majordom-financiar's chat tools/dashboard call this
# service without a per-user login.
VEHICLE_MANAGER_SERVICE_TOKEN=change_this_to_a_random_secret

# --- Majordom-financiar callback (for AB-account sync) ---
MAJORDOM_API_URL=http://majordom-api:8000
